{
  "uid": "pp-slo",
  "title": "SLO - upstream providers",
  "description": "SLIs, error budgets and burn rates of the public APIs Planet Pulse depends on.",
  "tags": [
    "planet-pulse",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:sli_good:ratio, provider)",
          "refId": "v"
        },
        "definition": "label_values(slo:sli_good:ratio, provider)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "",
        "sort": 1,
        "options": [],
        "hide": 0
      },
      {
        "name": "slo",
        "label": "SLO",
        "type": "custom",
        "query": "availability,latency,freshness",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "SLO alerts firing",
        "expr": "ALERTS{alertstate=\"firing\", alertname=~\"SLO.*\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{provider}} / {{slo}} ({{severity}})"
      }
    ]
  },
  "links": [
    {
      "title": "Planet Pulse",
      "type": "dashboards",
      "tags": [
        "planet-pulse"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
