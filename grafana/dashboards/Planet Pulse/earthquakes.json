      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (id, place, lat, lon) (usgs_earthquake_magnitude{dataset=\"earthquakes_m2.5_day\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (id, place, lat, lon) (usgs_earthquake_depth_km{dataset=\"earthquakes_m2.5_day\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (id, place, lat, lon) (usgs_earthquake_time_ms{dataset=\"earthquakes_m2.5_day\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
