          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Magnitude",
              "Value #B": "Depth (km)",
              "Value #C": "Time",
              "place": "Place"
            },
            "indexByName": {
              "Value #C": 0,
              "Value #A": 1,
              "place": 2,
              "Value #B": 3,
              "lat": 4,
              "lon": 5,
              "id": 6
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "lat",
                "destinationType": "number"
              },
              {
                "targetField": "lon",
                "destinationType": "number"
              },
              {
                "targetField": "Time",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
