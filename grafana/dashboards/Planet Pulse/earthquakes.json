{
  "uid": "pp-earthquakes",
  "title": "Earthquakes",
  "description": "Global seismic activity from the USGS real-time GeoJSON feeds.",
  "tags": [
    "planet-pulse",
    "earthquakes"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "M5.5+ earthquakes",
        "expr": "max by (id, place) (usgs_earthquake_time_ms{dataset=\"earthquakes_m2.5_day\"}) and on (id) max by (id) (usgs_earthquake_magnitude{dataset=\"earthquakes_m2.5_day\"} >= 5.5)",
        "useValueForTime": true,
        "step": "5m",
        "titleFormat": "Earthquake M5.5+",
        "textFormat": "{{place}}",
        "tagKeys": "id"
      }
    ]
  },
  "links": [
    {
      "title": "Planet Pulse",
      "type": "dashboards",
      "tags": [
        "planet-pulse"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "### 🌍 Earthquakes &nbsp;·&nbsp; <small>live feed from the [USGS Earthquake Hazards Program](https://earthquake.usgs.gov/earthquakes/feed/) - public domain, refreshed every minute</small>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Earthquakes M2.5+ - last 24 h",
      "description": "Every M2.5+ earthquake reported by USGS in the last 24 hours. Size = magnitude, colour = depth (red shallow < 70 km, orange intermediate, blue deep > 300 km).",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 16,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4.5
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Depth (km)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
