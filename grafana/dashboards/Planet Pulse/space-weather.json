{
  "uid": "pp-space",
  "title": "Space Weather",
  "description": "Sun, solar wind and geomagnetic activity from NOAA SWPC.",
  "tags": [
    "planet-pulse",
    "space-weather"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Geomagnetic storm (Kp ≥ 5)",
        "expr": "max(swpc_kp_estimated) >= 5",
        "step": "1m",
        "titleFormat": "Geomagnetic storm",
        "textFormat": "Kp ≥ 5"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "M/X-class flare",
        "expr": "space:xray_flare_class:level >= 3",
        "step": "1m",
        "titleFormat": "Solar flare M+",
        "textFormat": ""
      }
    ]
  },
  "links": [
    {
      "title": "Planet Pulse",
      "type": "dashboards",
      "tags": [
        "planet-pulse"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "### ☀️ Space weather &nbsp;·&nbsp; <small>data: [NOAA Space Weather Prediction Center](https://www.swpc.noaa.gov/) (public domain) - solar wind measured at L1, ~1.5 million km sunward, i.e. 30-60 min before it hits Earth</small>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Planetary K-index (geomagnetic activity)",
      "description": "Kp 0-9. Kp >= 5 is a geomagnetic storm (G1); Kp 9 = G5 'extreme'. Shaded bands = NOAA G-scale.",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 600000,
            "axisBorderShow": false,
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#FADE2A"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 6
              },
              {
                "color": "dark-red",
                "value": 7
              },
              {
                "color": "purple",
                "value": 8
              }
            ]
          },
          "min": 0,
          "max": 9,
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max over 3 h"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "swpc_kp_estimated",
          "legendFormat": "Kp (1-min estimate)",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "space:kp:max3h",
          "legendFormat": "max over 3 h",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ]
