# Copy to .env (git-ignored) and adjust. Every value has a safe default for
# local use - nothing here is required to start the stack.

# Grafana admin account (used for admin tasks; dashboards are editable anonymously).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Anonymous access: Editor = edit dashboards without logging in (local use).
# Use Viewer, or GF_ANONYMOUS_ENABLED=false, if anyone else can reach Grafana.
GF_ANONYMOUS_ENABLED=true
GF_ANONYMOUS_ROLE=Editor

# Shared secret between Grafana and grafana-image-renderer (internal network only).
GF_RENDERER_TOKEN=change-me-renderer-token

# Interface the published ports bind to. Keep 127.0.0.1 unless you put the
# stack behind a reverse proxy with authentication.
BIND_ADDR=127.0.0.1
